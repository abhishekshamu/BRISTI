# BRISTI Frontend environment
# Copy to .env to configure. Values are exposed to the browser — keep secrets out.

# Google Identity Services client ID (from Google Cloud Console).
# When empty, the "Sign in with Google" button renders disabled in development.
# The same OAuth app must be registered server-side via GOOGLE_CLIENT_ID (backend/.env).
VITE_GOOGLE_CLIENT_ID=

# Backend API origin. Leave empty to talk to a local API on the same machine
# (the Vite dev server proxies /api to it). Set it when the API is hosted
# elsewhere, e.g.:
#   VITE_API_BASE_URL=https://bristi-backend.onrender.com
# Also overrides the dev proxy target in vite.config.ts.
VITE_API_BASE_URL=
