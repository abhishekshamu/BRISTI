# BRISTI Admin environment
# Copy to .env to configure. Values are exposed to the browser — keep secrets out.

# Backend API origin. REQUIRED for production (Vercel): the admin SPA must call
# the deployed backend directly. Leave empty ONLY for local development (the
# Vite dev server proxies /api to localhost:5000).
# Example:
#   VITE_API_URL=https://bristi-backend.onrender.com
# A trailing /api is tolerated and never duplicated.
VITE_API_URL=

# Storefront origin, used for "view on storefront" links / previews in the CMS.
# Defaults to http://localhost:3000 during development.
VITE_FRONTEND_URL=http://localhost:3000
