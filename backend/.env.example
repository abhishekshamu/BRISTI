# ============================================
# BRISTI Backend Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================

# ---- Backend ----
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
API_RATE_LIMIT=300

# ---- MongoDB ----
# Use your MongoDB Atlas connection string:
# e.g. mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bristi?retryWrites=true&w=majority
# If this is left empty, the server falls back to an in-memory MongoDB (development only).
MONGODB_URI=

# ---- JWT ----
JWT_SECRET=development-only-access-secret-change-me
JWT_REFRESH_SECRET=development-only-refresh-secret-change-me
JWT_EXPIRE=30d
JWT_REFRESH_EXPIRE=60d
JWT_REFRESH_TOKEN_DAYS=60

# ---- Email (SMTP) ----
EMAIL_FROM=BRISTI <no-reply@bristi.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ---- Payments ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Media (Cloudinary) ----
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
